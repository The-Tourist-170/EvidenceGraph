# Required when an LLM integration is added (Phase 5).
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL_NAME=replace-with-your-model
LLM_API_KEY=replace-with-your-api-key

# Phase 5 real integrations. Keep false in development unless providers are
# configured; production always enables this path and fails if config is absent.
AI_INTEGRATIONS_ENABLED=false
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_COST_PER_MILLION_TOKENS=0

# Optional OpenAI-compatible embedding endpoint. Falls back to LLM_BASE_URL and
# LLM_API_KEY when omitted. EMBEDDING_DIMENSIONS must match the Qdrant collection.
# EMBEDDING_BASE_URL=https://api.example.com/v1
# EMBEDDING_MODEL_NAME=replace-with-your-embedding-model
# EMBEDDING_API_KEY=replace-with-your-embedding-key
EMBEDDING_BATCH_SIZE=32

# Optional OpenAI-compatible rerank endpoint. Without it, retrieval uses a
# deterministic lexical fallback.
# RERANK_ENDPOINT=https://api.example.com/v1/rerank
# RERANK_MODEL_NAME=replace-with-your-rerank-model
# RERANK_API_KEY=replace-with-your-rerank-key
RERANK_TIMEOUT_MS=15000
RERANK_MAX_CANDIDATES=50

# Provider-neutral MCP web search. Leave MCP_SEARCH_TRANSPORT empty to disable
# real web search; production research then fails with WEB_SEARCH_UNAVAILABLE.
# MCP_SEARCH_TRANSPORT=stdio          # or "http"
# MCP_SEARCH_COMMAND=your-mcp-server
# MCP_SEARCH_ARGS=["--stdio"]
# MCP_SEARCH_URL=https://mcp.example.com/mcp
# MCP_SEARCH_TOKEN=replace-with-your-mcp-token
MCP_SEARCH_TOOL=web_search
MCP_SEARCH_QUERY_FIELD=query
MCP_SEARCH_LIMIT_FIELD=limit
MCP_SEARCH_TIMEOUT_MS=15000
MCP_SEARCH_RATE_LIMIT_PER_MINUTE=30
MCP_SEARCH_MAX_RESULTS=10

# Optional LangSmith tracing. Never commit real keys.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=replace-with-your-langsmith-key
LANGSMITH_PROJECT=evidencegraph
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Local Valkey configuration
VALKEY_URL=redis://localhost:6380
VALKEY_PASSWORD=local-dev-password

# Phase 3 worker configuration
RESEARCH_WORKER_CONCURRENCY=4
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_WORKER_TIMEOUT_SECONDS=300
WORKER_LOCK_DURATION_MS=30000
WORKER_STALLED_INTERVAL_MS=30000
WORKER_CANCEL_POLL_INTERVAL_MS=100
WORKER_SHUTDOWN_TIMEOUT_MS=30000
SIMULATED_STAGE_DELAY_MS=150

# Local object-storage configuration
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=evidencegraph
MINIO_SECRET_KEY=local-dev-password
MINIO_BUCKET=evidencegraph-documents

# Local PostgreSQL configuration
DATABASE_URL=postgres://evidencegraph:local-dev-password@localhost:5433/evidencegraph

# Local vector and graph database configuration
QDRANT_URL=http://localhost:6335
EMBEDDING_DIMENSIONS=1536
NEO4J_URI=bolt://localhost:7688

# Other local infrastructure development defaults
POSTGRES_USER=evidencegraph
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=evidencegraph
NEO4J_AUTH=neo4j/local-dev-password
