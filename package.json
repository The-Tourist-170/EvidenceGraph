{
  "name": "evidencegraph",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --cwd apps/api dev",
    "dev:workers:research": "bun --cwd apps/workers dev:research",
    "dev:workers:documents": "bun --cwd apps/workers dev:documents",
    "test": "bun test",
    "test:phase2:integration": "RUN_PHASE2_INTEGRATION=1 bun test packages/queue/src/integration.test.js",
    "test:phase3:integration": "RUN_PHASE3_INTEGRATION=1 bun test apps/workers/src/integration.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "bun --cwd packages/persistence db:generate",
    "db:migrate": "bun --cwd packages/persistence db:migrate",
    "test:phase4:integration": "RUN_PHASE4_INTEGRATION=1 bun test packages/persistence/src/integration.test.js",
    "test:phase6:integration": "RUN_PHASE6_INTEGRATION=1 RUN_PHASE4_INTEGRATION=1 bun test packages/ai/src/graph/checkpointer.integration.test.js packages/persistence/src/integration.test.js",
    "test:phase7:integration": "RUN_PHASE7_INTEGRATION=1 bun test packages/auth/src/integration.test.js",
    "test:phase7:e2e": "bun apps/web/scripts/phase7-e2e-smoke.js",
    "verify:release": "bun scripts/verify-release.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.5.3"
  }
}
