{
  "name": "evidencegraph",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --cwd apps/api dev",
    "test": "bun test",
    "test:phase2:integration": "RUN_PHASE2_INTEGRATION=1 bun test packages/queue/src/integration.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "prettier": "^3.5.3"
  }
}
